{
  "name": "relief-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photo to bas-relief surface (STEP/STL) for CNC, fully in the browser.",
  "scripts": {
    "dev": "node tools/copy-ort.mjs && vite",
    "build": "node tools/copy-ort.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tune": "tsx tools/tune.ts",
    "export": "tsx tools/export.ts"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "occt-import-js": "^0.0.23",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
